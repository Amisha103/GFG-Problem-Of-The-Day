/* Structure of binary tree node
class Node
{
    int data;
    Node left, right;

    Node(int item)
    {
        data = item;
        left = right = null;
    }
}
*/
class Solution {
    int ans = Integer.MIN_VALUE;

    int maxDiff(Node root) {
        dfs(root, root.data);
        return ans;
    }

    void dfs(Node node, int maxAncestor) {
        if (node == null) {
            return;
        }

        if (node.data != maxAncestor) {
            ans = Math.max(ans, maxAncestor - node.data);
        }

        maxAncestor = Math.max(maxAncestor, node.data);

        dfs(node.left, maxAncestor);
        dfs(node.right, maxAncestor);
    }
}



