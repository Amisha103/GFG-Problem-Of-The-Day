''' Structure of Binary Tree Node
class Node:
    def __init__(self,val):
        self.data = val
        self.left = None
        self.right = None
'''
class Solution:
    def maxDiff(self, root):
        self.ans = float('-inf')
        self.dfs(root, root.data)
        return self.ans
      
    
    
    def dfs(self, node, par):
        if not node:
            return
        
        if par != node.data:
            self.ans = max(self.ans, par - node.data)
        
        par = max(par, node.data)
        self.dfs(node.left, par)
        self.dfs(node.right, par)
        
        
        
