class Solution {

    public String compress(String s) {

        int n = s.length();

        
        int[] z = calculateZ(s);

   
        int[] dp = new int[n + 1];

  
        int[] choice = new int[n + 1];

        dp[n] = 0;

        for (int i = n - 1; i >= 0; i--) {

            dp[i] = 1 + dp[i + 1];
            choice[i] = 0;


            if (i > 0 && 2 * i <= n && z[i] >= i) {

                int star = 1 + dp[2 * i];

                if (star <= dp[i]) {

                    dp[i] = star;
                    choice[i] = 1;
                }
            }
        }

        StringBuilder ans = new StringBuilder();

        int i = 0;

        while (i < n) {

            if (choice[i] == 0) {

                ans.append(s.charAt(i));
                i++;

            } else {

                ans.append('*');
                i = 2 * i;
            }
        }

        return ans.toString();
    }


    private int[] calculateZ(String s) {

        int n = s.length();

        int[] z = new int[n];

        int left = 0;
        int right = 0;

        for (int i = 1; i < n; i++) {

            if (i <= right) {
                z[i] = Math.min(right - i + 1,
                               z[i - left]);
            }

            while (i + z[i] < n &&
                   s.charAt(z[i]) == s.charAt(i + z[i])) {

                z[i]++;
            }

            if (i + z[i] - 1 > right) {

                left = i;
                right = i + z[i] - 1;
            }
        }

        return z;
    }
}



